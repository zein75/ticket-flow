{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ticketflow;Username=ticketflow;Password=ticketflow_password",
    "Redis": "localhost:6379"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Jwt": {
    "Issuer": "TicketFlow",
    "Audience": "TicketFlow.Api"
  },
  "ExpiredReservations": {
    "IntervalSeconds": 30
  },
  "QrCodes": {
    "SigningKey": "change-me-to-a-strong-qr-signing-key"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "TicketFlow.Worker"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
