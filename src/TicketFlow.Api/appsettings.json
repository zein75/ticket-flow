{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ticketflow;Username=ticketflow;Password=ticketflow_password"
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Jwt": {
    "Issuer": "TicketFlow",
    "Audience": "TicketFlow.Api",
    "SigningKey": "ticketflow-development-signing-key-change-me-64-characters"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
